<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PokéDex Academy" android:textStyle="bold" android:textSize="32sp" android:textColor="#C62838" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explora, aprende y colecciona" android:textSize="16sp" android:layout_marginBottom="18dp" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnCatalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explorar catálogo (Compose)" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnFavorites" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mis favoritos (Compose)" />
  <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configuración (XML)" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pokémon destacados" android:textStyle="bold" android:textSize="22sp" android:layout_marginTop="28dp" />
  <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conectando..." android:layout_marginBottom="12dp" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/featuredList" android:layout_width="match_parent" android:layout_height="165dp" />
 </LinearLayout>
</ScrollView>
